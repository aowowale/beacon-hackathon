{
  "name": "@beacon/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Beacon production API — the human opportunity router",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/sensible": "^6.0.2",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.1.0",
    "openai": "^4.73.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
