# ---- Runtime ----
# fake = fully local, deterministic providers (no cloud). live = Azure services.
PROVIDER_MODE=fake
PORT=8080
LOG_LEVEL=info
NODE_ENV=development

# Comma-separated allowed origins for CORS (web app origin)
CORS_ORIGINS=http://localhost:5173

# ---- Auth (Entra ID / MSAL) — only required when AUTH_MODE=entra ----
AUTH_MODE=disabled
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=

# ---- Live providers (only used when PROVIDER_MODE=live) ----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

COSMOS_ENDPOINT=
COSMOS_DATABASE=beacon
COSMOS_CONTAINER=outcomes

SERVICE_BUS_NAMESPACE=
SERVICE_BUS_TOPIC=beacon-events

KEY_VAULT_URI=
APPLICATIONINSIGHTS_CONNECTION_STRING=
